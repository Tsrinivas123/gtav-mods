SECRET_KEY=your-django-secret-key-here
DEBUG=False
DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Supabase Storage (Private Bucket) ──────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET=pawanmod-files

# ── Vercel ────────────────────────────────────────────────────────────
ALLOWED_HOSTS=gtav-mods.vercel.app,.vercel.app,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://gtav-mods.vercel.app,https://*.vercel.app

# ── Optional Payment Gateways ────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYPAL_CLIENT_ID=

# ── Email ────────────────────────────────────────────────────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
